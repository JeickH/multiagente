# Dependencias
node_modules/
venv/
__pycache__/
*.pyc

# Entornos
.env
.env.local
frontend/.env
frontend/.env.local
backend/.env

# Build
frontend/.next/
.DS_Store

# IDE
.vscode/
.idea/

# Docker volumes
postgres_data/

# Claude local settings (excepto agents que sí se versionan)
.claude/*
!.claude/agents/

backend/.venv
referencia/
identidad_gloma/
identidad_elecol/
gemini_secrets

# Credenciales locales — nunca a git
CREDENCIALES*.txt

# Material crudo de clientes — contiene credenciales de tenant, nunca a git
talulah bots/
tallas talulah/
# Anclado a la raíz a propósito: sin la `/` inicial el patrón también tapaba
# `frontend/public/demo_viajes/`, que es lo CONTRARIO de material crudo — son
# los flyers y videos que Amplify sirve al público y que el bot manda por
# WhatsApp. Tienen que estar versionados o el despliegue queda sin medios.
/demo_viajes/
# `marketing/` guarda material crudo (piezas, briefs) que no va a git. La
# excepción es el publicador de Instagram: es código sin secretos —las
# credenciales viven en SSM— y necesita historia y respaldo.
# Nota: hay que desexcluir el directorio padre (`marketing/*`) porque git no
# desciende a un directorio excluido.
marketing/*
!marketing/instagram/

BITACORA_*

# Originales de las fotos de mascotas antes de comprimirlas
# (`scripts/optimizar_fotos_mascotas.py`). Son ~70 MB de fotos de gente real:
# no van a git, pero NO se borran: el bucket no tiene versionado y este es el
# único camino de vuelta si una compresión sale mal.
respaldos_fotos_mascotas/

# Manifiesto de trabajo del optimizador: se regenera en cada corrida y se aplica
# con `sync_fotos_bd_mascotas.py`. El registro que sí importa —y sí va a git— es
# `registro_optimizacion_fotos.csv`.
backend/scripts/registro_optimizacion_pendientes_bd.json

# Material crudo del importador de RoyiPets (PDF de la fundación, ZIP de fotos,
# lo que extrae `extraer.py`). Son ~113 MB de insumo, no de código.
testdata/

# "Bucket" de fotos de desarrollo: el equivalente local de
# `gloma-mascotas-747456040509`. El backend escribe aquí cuando corre sin
# MASCOTAS_BUCKET (docker-compose lo monta en /app/media). Son fotos de gente
# real copiadas de producción para poder probar: nunca van a git.
media_local/

# Entregables para clientes: llevan pantallazos de la cuenta viva del tenant
# (su número de WhatsApp, su correo, su bandeja). Este repo es PÚBLICO —regla
# de seguridad #8—, así que el material de entrega se queda local y se manda
# por el canal que el CEO decida.
entregables/

# Planes de trabajo en HTML que se generan para revisar con el CEO. Llevan
# correos de clientes reales (regla de seguridad #8: este repo es PÚBLICO) y
# son fotos de un momento, no documentación viva: lo que sobrevive de ellos
# termina en la BITÁCORA o en documentacion_bd/.
PLAN_*.html
# Y cualquier otra extensión del mismo documento: al convertir uno de esos HTML
# a texto plano para leerlo, el .txt resultante quedó fuera del ignore y a un
# `git add -A` de publicar 7 correos de clientes reales en un repo público.
PLAN_*

# Artefacto incremental de TypeScript. Se regenera en cada build y cambia en
# cada máquina: estaba versionado y ensuciaba el árbol en todas las ramas.
frontend/tsconfig.tsbuildinfo

# Material crudo del demo de Natulcé (fotos y video del cliente), igual que
# `talulah bots/`. Son 4 MB de piezas que no son código y que el cliente puede
# volver a mandar.
demo natulce/

# Prompts y guiones de trabajo de una sesión. Apuntan a los `PLAN_*.html`, que
# ya están fuera del repo por llevar correos de clientes reales.
PROMPT_SESION_*.md

# Respaldo del módulo de mascotas (RETIRADO). Son las dos mitades de un mismo
# script: `respaldo_mascotas_dump.py` corre dentro de la VPC y `respaldo_mascotas.py`
# arma el zip local. Se dejan fuera del repo por decisión del CEO (25-sep-2026).
#
# OJO: ignorar no es respaldar. Estos scripts son la red de seguridad del dato
# de terceros que CLAUDE.md manda conservar ("no se borra nada"); fuera de git
# viven en un solo disco. Si se quieren proteger, el sitio es un commit.
backend/scripts/respaldo_mascotas.py
backend/scripts/respaldo_mascotas_dump.py
