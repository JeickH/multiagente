# Dependencias
node_modules/
venv/
__pycache__/
*.pyc

# Entornos
.env
.env.local
frontend/.env
frontend/.env.local
backend/.env

# Build
frontend/.next/
.DS_Store

# IDE
.vscode/
.idea/

# Docker volumes
postgres_data/

# Claude local settings (excepto agents que sí se versionan)
.claude/*
!.claude/agents/

backend/.venv
referencia/
identidad_gloma/
identidad_elecol/
gemini_secrets

# Credenciales locales — nunca a git
CREDENCIALES*.txt

# Material crudo de clientes — contiene credenciales de tenant, nunca a git
talulah bots/
tallas talulah/
demo_viajes/
# `marketing/` guarda material crudo (piezas, briefs) que no va a git. La
# excepción es el publicador de Instagram: es código sin secretos —las
# credenciales viven en SSM— y necesita historia y respaldo.
# Nota: hay que desexcluir el directorio padre (`marketing/*`) porque git no
# desciende a un directorio excluido.
marketing/*
!marketing/instagram/

BITACORA_*

# Originales de las fotos de mascotas antes de comprimirlas
# (`scripts/optimizar_fotos_mascotas.py`). Son ~70 MB de fotos de gente real:
# no van a git, pero NO se borran: el bucket no tiene versionado y este es el
# único camino de vuelta si una compresión sale mal.
respaldos_fotos_mascotas/

# Manifiesto de trabajo del optimizador: se regenera en cada corrida y se aplica
# con `sync_fotos_bd_mascotas.py`. El registro que sí importa —y sí va a git— es
# `registro_optimizacion_fotos.csv`.
backend/scripts/registro_optimizacion_pendientes_bd.json

# Material crudo del importador de RoyiPets (PDF de la fundación, ZIP de fotos,
# lo que extrae `extraer.py`). Son ~113 MB de insumo, no de código.
testdata/

# "Bucket" de fotos de desarrollo: el equivalente local de
# `gloma-mascotas-747456040509`. El backend escribe aquí cuando corre sin
# MASCOTAS_BUCKET (docker-compose lo monta en /app/media). Son fotos de gente
# real copiadas de producción para poder probar: nunca van a git.
media_local/

# Entregables para clientes: llevan pantallazos de la cuenta viva del tenant
# (su número de WhatsApp, su correo, su bandeja). Este repo es PÚBLICO —regla
# de seguridad #8—, así que el material de entrega se queda local y se manda
# por el canal que el CEO decida.
entregables/
