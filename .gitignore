# Dependencias
node_modules/
venv/
__pycache__/
*.pyc

# Entornos
.env
.env.local
frontend/.env
frontend/.env.local
backend/.env

# Build
frontend/.next/
.DS_Store

# IDE
.vscode/
.idea/

# Docker volumes
postgres_data/

# Claude local settings (excepto agents que sí se versionan)
.claude/*
!.claude/agents/

backend/.venv
referencia/
identidad_gloma/
identidad_elecol/
gemini_secrets

# Credenciales locales — nunca a git
CREDENCIALES*.txt

# Material crudo de clientes — contiene credenciales de tenant, nunca a git
talulah bots/
tallas talulah/
demo_viajes/
# `marketing/` guarda material crudo (piezas, briefs) que no va a git. La
# excepción es el publicador de Instagram: es código sin secretos —las
# credenciales viven en SSM— y necesita historia y respaldo.
# Nota: hay que desexcluir el directorio padre (`marketing/*`) porque git no
# desciende a un directorio excluido.
marketing/*
!marketing/instagram/

BITACORA_*
